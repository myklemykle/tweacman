# Build output (arduino-cli compile --build-path)
build/

# Python virtual environment for tools/ble_test.py
tools/venv/

# macOS
.DS_Store

# Generated test fixture for SDResampleDemo (tools/make_test_wav.py) -
# regenerate it, don't commit it.
/AUDIO.WAV
/SINE*.WAV
/SAW*.WAV

# Symlink to a locally-downloaded Renesas reference manual - not ours to
# redistribute, and the target path is machine-specific anyway.
r01uh0891ej0150-ra6m5.pdf

# Symlink into a dev machine's own sample library, for inspecting real
# WAV file formats from the coding environment - not reachable by the
# board and not portable across machines.
/SDResampleDemo/wav files

# Generated format test files for SDResampleDemo (tools/make_format_test_wavs.py) -
# regenerate them, don't commit them.
/test_wavs/

# Datasheets and reference drawings, mostly symlinks into a local Downloads
# folder - other people's PDFs, so not committed until we decide how to
# credit them (see OPEN_ITEMS.md, PCB "before publishing").
/datasheets/

# Symlink to the Bela project this one ported RV112FF from (see CLAUDE.md) -
# a separate repo, machine-specific path.
/gemtest.git

# Mouser order exports from pcb/tools/gen_bom.py --order N - live prices
# that go stale, regenerate rather than commit.
/pcb/*-mouser-order-*.csv
